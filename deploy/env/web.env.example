# 프론트엔드(web) 비밀값 예시. 복사해서 web.env 로 만듭니다 (git 에 올라가지 않음).
# 값은 작은따옴표로 감쌉니다. 따옴표 없이 쓰면 $ 가 든 값이 깨집니다.

# 주문·상태 알림 메일 (Gmail 주소와 앱 비밀번호)
EMAIL_USER=''
EMAIL_PASS=''
# 새 견적 알림을 받을 관리자 주소
ADMIN_EMAIL=''

# 결제 완료 후 돌아올 사이트 주소
NEXTAUTH_URL='https://www.maker3d.kr'

# 네이버페이 서버 키 (쓰는 경우)
NAVER_CLIENT_ID=''
NAVER_CLIENT_SECRET=''

# Google Cloud Storage (쓰는 경우). JSON 은 한 줄로.
GOOGLE_CLOUD_PROJECT_ID=''
GOOGLE_CLOUD_BUCKET_NAME=''
GOOGLE_APPLICATION_CREDENTIALS_JSON=''
