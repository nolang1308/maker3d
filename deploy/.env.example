# deploy/.env 예시. 복사해서 .env 로 만들고 값을 채웁니다 (git 에 올라가지 않음).
#   cp .env.example .env

# 올라온 파일과 인증서를 두는 서버 폴더
DATA_DIR=/srv/maker3d/data

# ── 주소 ──────────────────────────────────────────────
# [시험 기간] 도메인 연결 전. http://<서버 IP> 로 접속하고 백엔드는 같은 주소의 /backend 아래에 있습니다.
WEB_SITE=:80
API_SITE=:8080
NEXT_PUBLIC_SITE_URL=https://www.maker3d.kr
NEXT_PUBLIC_BACKEND_URL=http://서버.고정.IP/backend

# [도메인 연결 후] 위 네 줄을 아래로 바꾸고  docker compose up -d --build
# WEB_SITE=www.maker3d.kr
# API_SITE=maker3d-backend.maker3d.kr
# APEX_SITE=maker3d.kr
# (도메인이 아직 이 서버를 가리키지 않을 때 미리 확인하려면  REHEARSAL_TLS="tls internal"  을 함께 넣습니다.
#  자체 서명 인증서로 뜨므로 브라우저 경고가 납니다. 전환 후에는 이 줄을 지우고  docker compose up -d caddy)
# NEXT_PUBLIC_SITE_URL=https://www.maker3d.kr
# NEXT_PUBLIC_BACKEND_URL=https://maker3d-backend.maker3d.kr

# ── 네이버페이 (화면 코드에 들어가는 공개 값) ──────────
NEXT_PUBLIC_NAVER_PAY_CLIENT_ID=
NEXT_PUBLIC_NAVER_PAY_CHAIN_ID=

# ── 선택 ──────────────────────────────────────────────
# 견적 계산 제한 시간(밀리초). 기본 180000 (3분)
# SLICE_TIMEOUT_MS=180000
