# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Google Cloud Storage Key (보안상 중요!)
gcc.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/backend/node_modules
/photo
/node_modules
.DS_Store
.env.local
.env*.local

# 고객이 올린 파일 (PC 에서 가져온 사본). 공개 저장소에 절대 올리지 않음
/orders/
/saved-quotes/

# 같은 서버의 다른 프로젝트가 넣는 Caddy 사이트 파일 (예: farm.caddy). 이 저장소 것이 아님.
# 무시해 두면 커밋되지도 않고, git 이 치우거나 옮기지도 않는다.
deploy/caddy/*.caddy
!deploy/caddy/maker3d.caddy

# deploy/: 서버용 비밀값은 올리지 않음 (예시 파일만 올림)
deploy/.env
deploy/env/*
!deploy/env/*.example
!deploy/.env.example
