rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // posts 컬렉션
    match /posts/{postId} {
      // 읽기: 모든 사용자 허용
      allow read: if true;

      // 생성: 로그인된 사용자만 허용
      allow create: if request.auth != null;

      // 수정/삭제: 모든 사용자 허용 (비밀번호는 클라이언트에서 확인)
      allow update, delete: if true;
    }

    // notices 컬렉션
    match /notices/{noticeId} {
      // 읽기: 모든 사용자 허용
      allow read: if true;

      // 생성: 로그인된 사용자만 허용
      allow create: if request.auth != null;

      // 수정/삭제: 모든 사용자 허용 (비밀번호는 클라이언트에서 확인)
      allow update, delete: if true;
    }

    // orders 컬렉션 - 주문 정보
    match /orders/{orderId} {
      // 읽기: 인증된 사용자만 허용
      allow read: if request.auth != null;

      // 생성: 인증된 사용자만 주문 생성 가능
      allow create: if request.auth != null;

      // 수정: 인증된 사용자만 허용 (관리자가 주문 상태 변경)
      allow update: if request.auth != null;

      // 삭제: 인증된 사용자만 허용
      allow delete: if request.auth != null;
    }

    // portfolios 컬렉션 - 포트폴리오
    match /portfolios/{portfolioId} {
      // 읽기: 모든 사용자 허용
      allow read: if true;

      // 생성: 로그인된 사용자만 허용
      allow create: if request.auth != null;

      // 수정/삭제: 로그인된 사용자만 허용
      allow update, delete: if request.auth != null;
    }

    // popups 컬렉션 - 팝업 관리
    match /popups/{popupId} {
      // 읽기: 모든 사용자 허용 (메인 페이지 비로그인 접근)
      allow read: if true;

      // 생성/수정/삭제: 로그인된 사용자만 허용 (관리자)
      allow create, update, delete: if request.auth != null;
    }

    // materialColors 컬렉션 - 소재별 색상 관리
    match /materialColors/{material} {
      // 읽기: 모든 사용자 허용 (견적 페이지 비로그인 접근)
      allow read: if true;

      // 쓰기: 로그인된 사용자만 허용 (popups와 동일 패턴)
      allow create, update, delete: if request.auth != null;
    }

    // siteStats 컬렉션 - 방문 통계 (하루에 문서 하나, 문서 이름은 한국 시간 날짜 YYYY-MM-DD)
    // 방문자의 브라우저가 로그인 없이 숫자를 더하므로 쓰기를 열어 두되,
    // "오늘 문서에, 정해진 항목만" 쓸 수 있게 좁힌다 (지난 날짜를 고치거나 엉뚱한 문서를 만들 수 없다)
    match /siteStats/{day} {
      function kstDay(millis) {
        let t = timestamp.value(millis + 9 * 60 * 60 * 1000);
        return string(t.year()) + '-'
          + (t.month() < 10 ? '0' : '') + string(t.month()) + '-'
          + (t.day() < 10 ? '0' : '') + string(t.day());
      }

      // 자정 무렵에 보낸 기록이 날짜가 넘어간 뒤 도착해도 받도록 5분의 여유를 둔다
      function isToday() {
        return day == kstDay(request.time.toMillis())
          || day == kstDay(request.time.toMillis() - 5 * 60 * 1000);
      }

      function smallMap(name) {
        return !(name in request.resource.data)
          || (request.resource.data[name] is map && request.resource.data[name].size() <= 400);
      }

      function validStats() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'date', 'updatedAt', 'pageViews', 'visits', 'visitors', 'newVisitors',
            'pages', 'landings', 'channels', 'campaigns', 'keywords', 'referrers',
            'devices', 'hourViews', 'hourVisits', 'funnel', 'stepChannels', 'stepCampaigns'
          ])
          && data.date == day
          && data.get('pageViews', 0) is number
          && data.get('visits', 0) is number
          && smallMap('pages') && smallMap('landings') && smallMap('channels')
          && smallMap('campaigns') && smallMap('keywords') && smallMap('referrers');
      }

      // 읽기: 로그인된 사용자만 (관리자 화면)
      allow read: if request.auth != null;

      allow create: if isToday() && validStats();

      // 수정: 숫자를 줄이는 것은 막는다
      allow update: if isToday() && validStats()
        && request.resource.data.get('pageViews', 0) >= resource.data.get('pageViews', 0)
        && request.resource.data.get('visits', 0) >= resource.data.get('visits', 0);

      allow delete: if false;
    }
  }
}
